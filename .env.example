NEAR_NETWORK=testnet
REGISTRY_ACCOUNT=app.kheer-demo.testnet
RUNTIME_ACCOUNT=kheer-ops.testnet
# Function-call key scoped to the registry. Never a full-access key. Never commit.
RUNTIME_PRIVATE_KEY=
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
KNOWLEDGE_ENCRYPTION_KEY=
